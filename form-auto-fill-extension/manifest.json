{
  "manifest_version": 3,
  "name": "AFFS — Auto Form Fill",
  "version": "2.0.0",
  "minimum_chrome_version": "114",
  "key": "",
  "description": "Automates mid-term and end-term feedback submission on the HyperDyn feedback portal.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://192.168.10.72:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AFFS — Auto Form Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://192.168.10.72:8080/*"],
      "js": ["constants.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
